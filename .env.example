# Backend Server Configuration
PORT=3001

# Restaurant recommendations and text responses use OpenRouter's free Nemotron model.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Kakao Developers REST API Key (검색에 필수)
# 미입력 시 검색 불가. 가상 데이터로 자동 대체하지 않음
KAKAO_REST_API_KEY=your_kakao_rest_api_key_here

# Frontend API URL
VITE_API_URL=http://localhost:3001

# Discord (server only; never VITE_ prefix)
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
DISCORD_API_BASE=http://127.0.0.1:3001
# Optional HTTPS web link, update when temporary tunnel changes
PUBLIC_WEB_URL=

# Owner marketing (server only). Never add the VITE_ prefix.
OWNER_TEXT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
GROUP_FINAL_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OWNER_STT_MODEL=openai/gpt-4o-mini-transcribe
OWNER_IMAGE_MODEL=openai/gpt-image-1-mini
# Generate a random key with at least 24 characters. Required for approving owner accounts.
OWNER_ADMIN_KEY=
