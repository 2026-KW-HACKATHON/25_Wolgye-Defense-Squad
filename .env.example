# Backend Server Configuration
PORT=3001

# NVIDIA NIM API Key (https://build.nvidia.com)
NVIDIA_API_KEY=your_nvidia_nim_api_key_here
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# Kakao Developers REST API Key (검색에 필수)
# 미입력 시 검색 불가. 가상 데이터로 자동 대체하지 않음
KAKAO_REST_API_KEY=your_kakao_rest_api_key_here

# Frontend API URL
VITE_API_URL=http://localhost:3001

# Discord (server only; never VITE_ prefix)
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
DISCORD_API_BASE=http://127.0.0.1:3001
# Optional HTTPS web link, update when temporary tunnel changes
PUBLIC_WEB_URL=

# Owner marketing (server only). Never add the VITE_ prefix.
OPENROUTER_API_KEY=
OWNER_TEXT_MODEL=openai/gpt-4o-mini
OWNER_STT_MODEL=openai/gpt-4o-mini-transcribe
OWNER_IMAGE_MODEL=openai/gpt-image-1-mini

# 공용 DB (Supabase Postgres). file이면 .local-data에 저장
DATA_STORE=postgres
# Supabase → Connect → Session pooler 주소. 비밀번호에 [ ] 괄호를 남기지 말 것
DATABASE_URL=
DATABASE_CA_FILE=certs/prod-ca-2021.crt

# 로그인 (Supabase → Project Settings → API)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# 관리자 계정의 Supabase User ID, 여러 명이면 쉼표로 구분
AUTH_ADMIN_USER_IDS=
